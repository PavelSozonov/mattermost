# Managed by Ansible — local edits will be overwritten on the next deploy.
[Unit]
Description=Mattermost backup to S3
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=/etc/mattermost-backup.env
ExecStart=/usr/local/sbin/mattermost-backup.sh
Nice=10
IOSchedulingClass=idle
